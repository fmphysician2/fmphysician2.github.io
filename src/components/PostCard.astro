---
import { PILLAR_MAP } from '../consts';
const { post } = Astro.props;
const d = post.data;
const pillar = PILLAR_MAP[d.pillar];
const date = d.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
const href = `/${d.slug ?? post.id}/`;
---
<article class="card">
  <div class="card-main">
    <div class="card-meta">
      <time datetime={d.pubDate.toISOString()}>{date}</time>
      <span>・</span>
      <a href={`/pillar/${pillar.slug}/`}>{pillar.name}</a>
      <span>・</span>
      <span>{d.doctor} 醫師</span>
    </div>
    <h3><a href={href}>{d.title}</a></h3>
    <p>{d.answer}</p>
    {d.tags.length > 0 && (
      <div class="tags">{d.tags.slice(0, 3).map((t: string) => <span class="tag">#{t}</span>)}</div>
    )}
  </div>
  {d.cover && (
    <a class="card-thumb" href={href} aria-hidden="true" tabindex="-1">
      <img src={d.cover} alt="" loading="lazy" width="264" height="264" />
    </a>
  )}
</article>
