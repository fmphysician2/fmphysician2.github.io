---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE, PILLAR_MAP } from '../consts';

// 全站文章一頁列完。首頁只放最新 20 篇（見 pages/index.astro），
// 這頁是所有文章的樞紐：讀者回顧舊文、爬蟲一次取得全部連結都靠它。
// 刻意不做分頁——分頁子頁對搜尋引擎是薄內容，也會把舊文推到第二層。
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const counts: Record<string, number> = {};
for (const p of posts) counts[p.data.pillar] = (counts[p.data.pillar] ?? 0) + 1;

// 依年份分組，超過一年份時才顯示年份標題
const groups = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.pubDate.getFullYear();
  if (!groups.has(y)) groups.set(y, []);
  groups.get(y)!.push(p);
}
const showYear = groups.size > 1;

const title = '全部文章';
const desc = `${SITE.name}的所有衛教文章一覽，共 ${posts.length} 篇，依發布日期排序。`;

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/archive/#page`,
    name: `${title}｜${SITE.name}`,
    description: desc,
    url: `${SITE.url}/archive/`,
    isPartOf: { '@id': `${SITE.url}/#website` },
    mainEntity: { '@id': `${SITE.url}/archive/#list` },
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/archive/#list`,
    numberOfItems: posts.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.url}/${p.data.slug ?? p.id}/`,
      name: p.data.title,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: title, item: `${SITE.url}/archive/` },
    ],
  },
];
---
<Base title={title} description={desc} schema={schema}>
  <Hero slot="hero" compact={true} />
  <div class="wrap layout">
    <div>
      <nav aria-label="麵包屑" style="font-size:.82rem;color:var(--ink-3);padding-top:20px">
        <a href="/">首頁</a> ／ {title}
      </nav>
      <div class="page-head" style="padding-top:10px">
        <h1>{title}</h1>
        <p>共 {posts.length} 篇，依發布日期由新到舊排列。</p>
      </div>

      {posts.length === 0
        ? <div class="empty" style="margin-top:16px">文章準備中。</div>
        : [...groups.entries()].map(([year, list]) => (
            <>
              {showYear && <p class="arc-year">{year} 年</p>}
              <ul class="arc">
                {list.map((p) => {
                  const pillar = PILLAR_MAP[p.data.pillar];
                  return (
                    <li>
                      <a class="arc-row" href={`/${p.data.slug ?? p.id}/`}>
                        <time class="arc-date" datetime={p.data.pubDate.toISOString()}>
                          {p.data.pubDate.toLocaleDateString('zh-TW', { month: '2-digit', day: '2-digit' })}
                        </time>
                        <span class="arc-pillar">{pillar.name}</span>
                        <span class="arc-title">{p.data.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </>
          ))}
    </div>
    <Sidebar counts={counts} current="archive" />
  </div>
</Base>
