---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DoctorSignature from '../components/DoctorSignature.astro';
import { SITE, DOCTORS, PILLAR_MAP, DISCLAIMER, otherDoctor } from '../consts';
import { extractFaqs, questionFaqs } from '../lib/faq';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post, all: posts },
  }));
}

const { post, all } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const doc = DOCTORS[d.doctor];
const reviewer = otherDoctor(d.doctor);
const pillar = PILLAR_MAP[d.pillar];
const url = `${SITE.url}/${d.slug ?? post.id}/`;

// 列出同分類的其他文章
const related = all
  .filter((p) => p.id !== post.id && p.data.pillar === d.pillar)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const faqs = questionFaqs(extractFaqs(post.body ?? ''));
const dateStr = d.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });

const schema: object[] = [
  {
    '@type': ['MedicalWebPage', 'Article'],
    '@id': `${url}#article`,
    headline: d.title,
    name: d.title,
    description: d.answer,
    abstract: d.answer,
    inLanguage: SITE.lang,
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: { '@id': `${SITE.url}/about/#${encodeURIComponent(doc.name)}` },
    // 兩位醫師互審：撰寫者以外的那位醫師負責審閱，reviewedBy 交叉指向對方，
    // 不會出現自己審自己的情況。
    reviewedBy: { '@id': `${SITE.url}/about/#${encodeURIComponent(reviewer.name)}` },
    publisher: { '@id': `${SITE.url}/#organization` },
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@type': 'MedicalEntity', name: pillar.name },
    keywords: d.tags.join('、'),
    articleSection: pillar.name,
    image: new URL(d.cover ?? '/images/og-default.jpg', SITE.url).href,
    // 指定語音助理朗讀時要唸的區塊
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.answer p', 'h1'] },
    lastReviewed: (d.updatedDate ?? d.pubDate).toISOString().slice(0, 10),
    audience: { '@type': 'Patient' },
    disclaimer: DISCLAIMER,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: pillar.name, item: `${SITE.url}/pillar/${pillar.slug}/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];

if (faqs.length > 0) {
  schema.push({
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}
---
<Base title={d.title} description={d.answer} ogType="article" ogImage={d.cover ?? '/images/og-default.jpg'} schema={schema}>
  <Hero slot="hero" compact={true} />
  <div class="wrap" style="padding:24px 0 56px;max-width:820px">
    <nav aria-label="麵包屑" style="font-size:.82rem;color:var(--ink-3);margin-bottom:14px">
      <a href="/">首頁</a> ／ <a href={`/pillar/${pillar.slug}/`}>{pillar.name}</a>
    </nav>
    <article class="article">
      <h1>{d.title}</h1>
      <div class="article-meta">
        <time datetime={d.pubDate.toISOString()}>{dateStr}</time>
        <span>{doc.entityLine}</span>
        <a href={`/pillar/${pillar.slug}/`}>{pillar.name}</a>
        {d.updatedDate && <span>更新於 {d.updatedDate.toLocaleDateString('zh-TW')}</span>}
      </div>

      <div class="answer">
        <span class="lbl">一句話結論</span>
        <p>{d.answer}</p>
      </div>

      <div class="prose"><Content /></div>

      <DoctorSignature doctor={d.doctor} />

      {d.tags.length > 0 && (
        <div class="tags" style="margin-top:20px">{d.tags.map((t: string) => <span class="tag tag-o">#{t}</span>)}</div>
      )}

      {related.length > 0 && (
        <section class="related">
          <h2>同主題延伸閱讀・{pillar.name}</h2>
          <ul>{related.map((r) => (
            <li><a href={`/${r.data.slug ?? r.id}/`}>{r.data.title}</a></li>
          ))}</ul>
        </section>
      )}
    </article>
  </div>
</Base>
