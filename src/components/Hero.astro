---
import { SITE, LINKS } from '../consts';
const { compact = false } = Astro.props;
---
<header class="hero">
  <a href="/" aria-label={`${SITE.name} 首頁`}>
    <div class="hero-cover">
      <picture>
        <source media="(max-width: 860px)" srcset="/images/cover-mobile.webp" />
        <img src="/images/cover.webp" width="1530" height="592" alt={`${SITE.name} — ${SITE.byline}`} fetchpriority="high" />
      </picture>
    </div>
  </a>
  <div class="hero-body">
    <a class="hero-avatar" href="/" aria-hidden="true" tabindex="-1">
      <img src="/images/avatar.webp" width="512" height="512" alt="" />
    </a>
    <div class="hero-text">
      {compact
        ? <p class="hero-name" style="margin:0 0 4px;font-size:1.65rem;font-weight:600;line-height:1.3"><a href="/">{SITE.name}</a></p>
        : <h1>{SITE.name}・{SITE.tagline}</h1>}
      <p class="hero-sub">{SITE.bio}　{SITE.byline}</p>
      <p class="hero-pitch">{SITE.pitch}</p>
    </div>
  </div>
  <nav class="hero-links" aria-label="社群與導覽連結">
    <a class="chip chip-solid" href="/">全部文章</a>
    <a class="chip" href="/about/">關於我們</a>
    <a class="chip" href={LINKS.facebook} rel="me noopener" target="_blank">Facebook</a>
    <a class="chip" href={LINKS.instagram} rel="me noopener" target="_blank">Instagram</a>
    <a class="chip" href={LINKS.threads} rel="me noopener" target="_blank">Threads</a>
    <a class="chip" href={LINKS.linkgoods} rel="noopener" target="_blank">linkgoods</a>
  </nav>
</header>
