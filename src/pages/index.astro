---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Sidebar from '../components/Sidebar.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const counts: Record<string, number> = {};
for (const p of posts) counts[p.data.pillar] = (counts[p.data.pillar] ?? 0) + 1;

const itemList = {
  '@type': 'ItemList',
  '@id': `${SITE.url}/#articles`,
  itemListElement: posts.slice(0, 20).map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE.url}/${p.data.slug ?? p.id}/`,
    name: p.data.title,
  })),
};
---
<Base title={SITE.name} description={SITE.description} schema={[itemList]}>
  <Hero slot="hero" />
  <div class="wrap layout">
    <div>
      {posts.length === 0
        ? <div class="empty">文章準備中。</div>
        : <div class="cards">{posts.map((p) => <PostCard post={p} />)}</div>}
    </div>
    <Sidebar counts={counts} />
  </div>
</Base>
